<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="6dp"
    android:background="@drawable/bg_continue_card" android:elevation="10dp">

    <ImageButton android:id="@+id/btnSelHighlight" android:layout_width="44dp" android:layout_height="44dp"
        android:src="@drawable/ic_highlighter" android:tint="#FFFFFF"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Highlight"/>

    <ImageButton android:id="@+id/btnSelReadAloud" android:layout_width="44dp" android:layout_height="44dp"
        android:src="@drawable/ic_speak" android:tint="#FFFFFF"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Read aloud"/>

    <ImageButton android:id="@+id/btnSelTranslate" android:layout_width="44dp" android:layout_height="44dp"
        android:src="@drawable/ic_translate" android:tint="#FFFFFF"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Translate"/>

    <View android:layout_width="1dp" android:layout_height="28dp" android:background="#2A2A2A"
        android:layout_gravity="center_vertical" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"/>

    <ImageButton android:id="@+id/btnSelClose" android:layout_width="44dp" android:layout_height="44dp"
        android:src="@drawable/ic_close" android:tint="#888888"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Cancel selection"/>

</LinearLayout>