<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_continue_card"
    android:tag="theme:card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <View
        android:id="@+id/noteCardColorDot"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:minHeight="40dp"
        android:layout_marginEnd="14dp"
        android:background="#FFEE00"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/noteCardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="theme:textPrimary"
            android:textSize="14sp"
            android:textColor="#EEEEEE"
            android:lineSpacingMultiplier="1.3"/>

        <TextView
            android:id="@+id/noteCardTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="theme:textSecondary"
            android:textSize="10sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/noteCardDelete"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:tag="theme:accent"
        android:src="@drawable/ic_close"
        android:tint="#555555"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete note"/>

</LinearLayout>