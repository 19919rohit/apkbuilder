<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_recent_card">

        <ImageView
            android:id="@+id/bookCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/bookInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2A2A2A"/>

        <ImageButton
            android:id="@+id/bookRemove"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_button_dark"
            android:padding="5dp"
            android:tint="#CCCCCC"
            android:contentDescription="Remove"
            android:visibility="gone"/>

    </FrameLayout>

    <TextView
        android:id="@+id/bookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="theme:textPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#EEEEEE"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/bookTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="theme:textSecondary"
        android:textSize="10sp"
        android:textColor="#707070"
        android:layout_marginTop="2dp"/>

</LinearLayout>