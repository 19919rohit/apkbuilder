<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp"
    android:tag="theme:card"
    android:background="@drawable/bg_continue_card" android:elevation="12dp">

    <android.widget.GridLayout
        android:id="@+id/colorSwatchGrid"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:columnCount="5"/>

    <View android:tag="theme:divider" android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#2A2A2A" android:layout_marginTop="10dp" android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/customHexInput"
        android:tag="theme:textPrimary"
        android:layout_width="180dp" android:layout_height="44dp"
        android:hint="#RRGGBB" android:textColorHint="#666666"
        android:textColor="#FFFFFF" android:textSize="13sp"
        android:background="@drawable/bg_button_dark"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:singleLine="true" android:inputType="text"/>

    <TextView
        android:id="@+id/btnUseHex"
        android:tag="theme:buttonBg,theme:buttonText"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:layout_marginTop="8dp" android:gravity="center"
        android:text="Use this color" android:textSize="13sp" android:textStyle="bold"
        android:textColor="#000000" android:background="@drawable/bg_open_button"
        android:clickable="true" android:focusable="true"/>

</LinearLayout>