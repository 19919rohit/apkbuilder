<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:minWidth="160dp"
    android:tag="theme:card"
    android:background="@drawable/bg_continue_card" android:elevation="8dp">

    <TextView android:id="@+id/themeMenuEdit" android:tag="theme:textPrimary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Edit" android:textSize="14sp" android:textStyle="bold" android:textColor="#EEEEEE"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="14dp" android:paddingBottom="14dp"
        android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"/>

    <View android:tag="theme:divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A"/>

    <!-- Intentionally NOT tagged — see popup_library_overflow.xml note. -->
    <TextView android:id="@+id/themeMenuDelete"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Delete" android:textSize="14sp" android:textStyle="bold" android:textColor="#FF5252"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="14dp" android:paddingBottom="14dp"
        android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"/>

</LinearLayout>