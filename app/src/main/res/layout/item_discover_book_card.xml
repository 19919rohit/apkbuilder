<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_margin="8dp" android:padding="8dp"
    android:tag="theme:card"
    android:background="@drawable/bg_continue_card">

    <FrameLayout
        android:layout_width="match_parent" android:layout_height="190dp"
        android:background="@drawable/bg_recent_card">

        <ImageView android:id="@+id/discoverCardCover"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <TextView android:id="@+id/discoverCardFeaturedBadge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|start" android:layout_margin="6dp"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:background="@drawable/bg_button_dark"
            android:text="★ Featured" android:textSize="9sp" android:textStyle="bold" android:textColor="#FFC400"
            android:visibility="gone"/>

    </FrameLayout>

    <TextView android:id="@+id/discoverCardTitle" android:tag="theme:textPrimary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:textColor="#EEEEEE"
        android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="1.15"
        android:layout_marginTop="8dp"/>

    <TextView android:id="@+id/discoverCardAuthor" android:tag="theme:textSecondary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="#707070"
        android:maxLines="1" android:ellipsize="end"
        android:layout_marginTop="2dp"/>

    <TextView android:id="@+id/discoverCardMeta" android:tag="theme:textSecondary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="10sp" android:textColor="#666666"
        android:maxLines="1" android:ellipsize="end"
        android:layout_marginTop="4dp"/>

    <!-- Download button (default state) -->
    <TextView android:id="@+id/discoverCardBtnDownload"
        android:tag="theme:buttonBg,theme:buttonText"
        android:layout_width="match_parent" android:layout_height="36dp"
        android:layout_marginTop="8dp" android:gravity="center"
        android:text="Download" android:textSize="12sp" android:textStyle="bold"
        android:textColor="#000000" android:background="@drawable/bg_open_button"
        android:clickable="true" android:focusable="true"/>

    <!-- Progress state (shown while downloading) -->
    <LinearLayout android:id="@+id/discoverCardProgressGroup"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/discoverCardProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:max="100" android:progress="0"/>

        <TextView android:id="@+id/discoverCardProgressText" android:tag="theme:textSecondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center"
            android:textSize="10sp" android:textColor="#707070"
            android:text="Downloading… 0%"/>

    </LinearLayout>

    <!-- Open button (shown once downloaded) -->
    <TextView android:id="@+id/discoverCardBtnOpen"
        android:tag="theme:outline"
        android:layout_width="match_parent" android:layout_height="36dp"
        android:layout_marginTop="8dp" android:gravity="center"
        android:text="Open" android:textSize="12sp" android:textStyle="bold"
        android:background="@drawable/bg_outline_button"
        android:clickable="true" android:focusable="true"
        android:visibility="gone"/>

</LinearLayout>