<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#080808">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:overScrollMode="never"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:paddingTop="56dp" android:paddingBottom="18dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="32dp" android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_back" android:tint="#888888"
                    android:background="@drawable/bg_file_initial"
                    android:contentDescription="Go back"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:id="@+id/editorTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Create Theme" android:textSize="26sp"
                    android:textStyle="bold" android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- PREVIEW -->
            <LinearLayout
                android:id="@+id/previewCard"
                android:layout_width="match_parent" android:layout_height="120dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_continue_card">

                <TextView
                    android:id="@+id/previewSampleText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Aa" android:textSize="34sp" android:textStyle="bold"/>

                <TextView
                    android:id="@+id/previewSubText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Live preview" android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <EditText
                android:id="@+id/themeNameInput"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="18dp"
                android:hint="Theme name" android:textColorHint="#666666"
                android:textColor="#FFFFFF" android:textSize="15sp"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:singleLine="true"/>

            <!-- COLOR ROWS -->
            <LinearLayout android:id="@+id/rowBackground" style="@style/ColorPickRow">
                <TextView style="@style/ColorPickRowLabel" android:text="Background"/>
                <View android:id="@+id/dotBackground" style="@style/ColorPickDot" android:background="#080808"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowCard" style="@style/ColorPickRow">
                <TextView style="@style/ColorPickRowLabel" android:text="Card / Surface"/>
                <View android:id="@+id/dotCard" style="@style/ColorPickDot" android:background="#151515"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowTextPrimary" style="@style/ColorPickRow">
                <TextView style="@style/ColorPickRowLabel" android:text="Text Color"/>
                <View android:id="@+id/dotTextPrimary" style="@style/ColorPickDot" android:background="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowAccent" style="@style/ColorPickRow">
                <TextView style="@style/ColorPickRowLabel" android:text="Accent Color"/>
                <View android:id="@+id/dotAccent" style="@style/ColorPickDot" android:background="#4488FF"/>
            </LinearLayout>

            <!-- FONT -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FONT" android:textSize="10sp" android:letterSpacing="0.16"
                android:textColor="#707070"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:layout_marginTop="20dp" android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/fontChoiceRow"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"/>

            <!-- TEXT SIZE -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TEXT SIZE" android:textSize="10sp" android:letterSpacing="0.16"
                android:textColor="#707070"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:layout_marginTop="20dp" android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp">

                <TextView android:id="@+id/sizeSmall" style="@style/TextSizeChoice" android:text="Small"/>
                <TextView android:id="@+id/sizeMedium" style="@style/TextSizeChoice" android:text="Medium" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/sizeLarge" style="@style/TextSizeChoice" android:text="Large"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnSaveTheme"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_margin="24dp" android:gravity="center"
                android:text="Save Theme" android:textSize="15sp" android:textStyle="bold"
                android:textColor="#000000" android:background="@drawable/bg_open_button"
                android:clickable="true" android:focusable="true"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>