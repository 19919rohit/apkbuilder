<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#080808">

    <!-- NOTE: this screen's OWN chrome is deliberately NOT theme-tagged.
         When building or editing a theme you need a stable, neutral
         canvas to judge colors against — if the editor itself flipped
         to whatever theme is currently active app-wide, picking colors
         for a new theme while a bright Light theme is active would be
         actively disorienting. Only the live preview mockup below (and
         this screen's own popups) reflect theming. -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:overScrollMode="never"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:paddingTop="48dp" android:paddingBottom="10dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="32dp" android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_back" android:tint="#888888"
                    android:background="@drawable/bg_file_initial"
                    android:contentDescription="Go back"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:id="@+id/editorTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Create Theme" android:textSize="22sp"
                    android:textStyle="bold" android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- ═══════════ LIVE PREVIEW — a real mockup screen, not
                 a swatch. Covers every element type the app's own
                 theme tags exist for: icon (accent), heading + subtitle
                 (textPrimary / textSecondary), divider, a card surface
                 with an outline stroke, body + meta text, and both a
                 filled and an outlined button. Every field below updates
                 this live, on every color pick, font pick, and size
                 pick. ═══════════ -->

            <LinearLayout
                android:id="@+id/previewScaffold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_recent_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/previewIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_stats"
                        android:background="@drawable/bg_file_initial"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/previewHeading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Library"
                            android:textStyle="bold"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/previewSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 PDFs · Updated today"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/previewDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#2A2A2A"/>

                <LinearLayout
                    android:id="@+id/previewCardSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_continue_card">

                    <TextView
                        android:id="@+id/previewCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Continue Reading"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/previewCardBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chapter 4 — The Journey Begins"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/previewCardMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Page 42 of 210"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/previewFilledButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:text="Open"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_open_button"/>

                    <TextView
                        android:id="@+id/previewOutlineButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Cancel"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_outline_button"/>
                </LinearLayout>

            </LinearLayout>

            <EditText
                android:id="@+id/themeNameInput"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="14dp"
                android:hint="Theme name" android:textColorHint="#666666"
                android:textColor="#FFFFFF" android:textSize="14sp"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:singleLine="true"/>

            <!-- 8 COLOR ROWS -->
            <LinearLayout android:id="@+id/rowBackground" style="@style/ColorPickRowTight">
                <TextView style="@style/ColorPickRowLabel" android:text="Background"/>
                <View android:id="@+id/dotBackground" style="@style/ColorPickDot" android:background="#080808"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowCard" style="@style/ColorPickRowTight">
                <TextView style="@style/ColorPickRowLabel" android:text="Card / Surface"/>
                <View android:id="@+id/dotCard" style="@style/ColorPickDot" android:background="#151515"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowDivider" style="@style/ColorPickRowTight">
                <TextView style="@style/ColorPickRowLabel" android:text="Divider"/>
                <View android:id="@+id/dotDivider" style="@style/ColorPickDot" android:background="#2A2A2A"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowTextPrimary" style="@style/ColorPickRowTight">
                <TextView style="@style/ColorPickRowLabel" android:text="Text Color"/>
                <View android:id="@+id/dotTextPrimary" style="@style/ColorPickDot" android:background="#FFFFFF"/>
            </LinearLayout>

            <!-- NEW: previously text-secondary had no picker at all and
                 was silently auto-derived — this row is what was missing. -->
            <LinearLayout android:id="@+id/rowTextSecondary" style="@style/ColorPickRowTight">
                <TextView style="@style/ColorPickRowLabel" android:text="Text Secondary"/>
                <View android:id="@+id/dotTextSecondary" style="@style/ColorPickDot" android:background="#8A8A8A"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowAccent" style="@style/ColorPickRowTight">
                <TextView style="@style/ColorPickRowLabel" android:text="Accent Color"/>
                <View android:id="@+id/dotAccent" style="@style/ColorPickDot" android:background="#4488FF"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowButtonText" style="@style/ColorPickRowTight">
                <TextView style="@style/ColorPickRowLabel" android:text="Button Text"/>
                <View android:id="@+id/dotButtonText" style="@style/ColorPickDot" android:background="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowOutline" style="@style/ColorPickRowTight">
                <TextView style="@style/ColorPickRowLabel" android:text="Outline"/>
                <View android:id="@+id/dotOutline" style="@style/ColorPickDot" android:background="#4488FF"/>
            </LinearLayout>

            <!-- FONT -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FONT" android:textSize="10sp" android:letterSpacing="0.16"
                android:textColor="#707070"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/fontChoiceRow"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="24dp" android:paddingEnd="24dp"/>
            </HorizontalScrollView>

            <!-- TEXT SIZE — 6dp gap from Font row, kept tight so both
                 controls are visible together without scrolling. -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TEXT SIZE" android:textSize="10sp" android:letterSpacing="0.16"
                android:textColor="#707070"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:layout_marginTop="6dp" android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp">

                <TextView android:id="@+id/sizeSmall" style="@style/TextSizeChoice" android:text="Small"/>
                <TextView android:id="@+id/sizeMedium" style="@style/TextSizeChoice" android:text="Medium" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/sizeLarge" style="@style/TextSizeChoice" android:text="Large"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnSaveTheme"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_margin="20dp" android:gravity="center"
                android:text="Save Theme" android:textSize="15sp" android:textStyle="bold"
                android:textColor="#000000" android:background="@drawable/bg_open_button"
                android:clickable="true" android:focusable="true"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>