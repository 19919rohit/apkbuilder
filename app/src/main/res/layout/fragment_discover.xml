<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:tag="theme:bg"
    android:background="#080808">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="24dp" android:paddingEnd="16dp"
            android:paddingTop="56dp" android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">

                <TextView android:tag="theme:textSecondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="EXPLORE" android:textSize="11sp"
                    android:textColor="#8A8A8A" android:letterSpacing="0.12"/>

                <TextView android:tag="theme:textPrimary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Discover" android:textSize="34sp"
                    android:textStyle="bold" android:textColor="#FFFFFF"
                    android:letterSpacing="-0.015" android:layout_marginTop="1dp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/discoverSortButton"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_toc" android:tint="#AAAAAA"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sort"/>

        </LinearLayout>

        <EditText
            android:id="@+id/discoverSearchInput"
            android:tag="theme:card,theme:textPrimary"
            android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_dark"
            android:hint="Search books, authors, categories…"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF" android:textSize="14sp"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:singleLine="true" android:imeOptions="actionSearch" android:inputType="text"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="14dp" android:paddingBottom="10dp">

            <TextView android:id="@+id/discoverCountLabel" android:tag="theme:textSecondary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="0 books"
                android:textSize="11sp" android:textColor="#707070"/>

            <TextView
                android:id="@+id/discoverFeaturedToggle"
                android:tag="theme:card,theme:textPrimary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="★ Featured" android:textSize="12sp" android:textStyle="bold"
                android:textColor="#DDDDDD" android:background="@drawable/bg_button_dark"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="8dp" android:paddingBottom="8dp"
                android:clickable="true" android:focusable="true"/>

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/discoverSwipeRefresh"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent" android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/discoverRecycler"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp"
                    android:clipToPadding="false" android:overScrollMode="never"
                    android:visibility="gone"/>

                <!-- LOADING SKELETON — a static 3x2 grid of placeholder
                     cards whose alpha is pulsed via one ValueAnimator on
                     the whole container in DiscoverFragment, matching the
                     lightweight shimmer technique already used elsewhere
                     in the app (no new shimmer library dependency). -->
                <LinearLayout
                    android:id="@+id/discoverSkeletonContainer"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp"
                    android:visibility="gone">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/bg_continue_card"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/bg_continue_card"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/bg_continue_card"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/bg_continue_card"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/bg_continue_card"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/bg_continue_card"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- EMPTY STATE — catalog genuinely has zero books -->
                <LinearLayout
                    android:id="@+id/discoverEmptyState"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="48dp" android:paddingEnd="48dp"
                    android:visibility="gone">

                    <TextView android:layout_width="72dp" android:layout_height="72dp"
                        android:gravity="center" android:text="📚" android:textSize="34sp"
                        android:background="@drawable/bg_continue_card"/>

                    <TextView android:tag="theme:textPrimary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="No books available yet" android:textSize="17sp"
                        android:textStyle="bold" android:textColor="#DDDDDD"
                        android:layout_marginTop="22dp"/>

                    <TextView android:tag="theme:textSecondary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Check back soon — new free books are added regularly."
                        android:textSize="13sp" android:textColor="#7A7A6A"
                        android:gravity="center" android:lineSpacingMultiplier="1.6"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>

                <!-- NO SEARCH RESULTS — distinct from the true empty state -->
                <TextView
                    android:id="@+id/discoverNoResultsText"
                    android:tag="theme:textSecondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="top" android:layout_marginTop="40dp"
                    android:text="No books match your search" android:textSize="13sp"
                    android:textColor="#666666" android:gravity="center"
                    android:visibility="gone"/>
                <!-- ERROR STATE — Firestore request failed with nothing
                     usable to fall back on -->
                <LinearLayout
                    android:id="@+id/discoverErrorState"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="48dp" android:paddingEnd="48dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="72dp" android:layout_height="72dp"
                        android:gravity="center" android:text="⚠" android:textSize="30sp"
                        android:textColor="#FF6B6B"
                        android:background="@drawable/bg_continue_card"/>

                    <TextView
                        android:id="@+id/discoverErrorTitle"
                        android:tag="theme:textPrimary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Couldn't load Discover"
                        android:textSize="17sp" android:textStyle="bold" android:textColor="#DDDDDD"
                        android:layout_marginTop="22dp"/>

                    <TextView
                        android:id="@+id/discoverErrorMessage"
                        android:tag="theme:textSecondary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Check your connection and try again."
                        android:textSize="13sp" android:textColor="#7A7A6A"
                        android:gravity="center" android:lineSpacingMultiplier="1.5"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/discoverRetryButton"
                        android:tag="theme:buttonBg,theme:buttonText"
                        android:layout_width="wrap_content" android:layout_height="46dp"
                        android:layout_marginTop="20dp"
                        android:paddingStart="32dp" android:paddingEnd="32dp"
                        android:gravity="center" android:text="Retry"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#000000"
                        android:background="@drawable/bg_open_button"
                        android:clickable="true" android:focusable="true"/>
                    <TextView
                        android:tag="theme:textSecondary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Or play while you wait" android:textSize="11sp"
                        android:textColor="#666666" android:layout_marginTop="28dp"/>

                    <FrameLayout
                        android:layout_width="match_parent" android:layout_height="220dp"
                        android:layout_marginTop="10dp"
                        android:tag="theme:card"
                        android:background="@drawable/bg_continue_card">

                        <neunix.pagevibe.app.GameView
                            android:id="@+id/discoverGameView"
                            android:layout_width="match_parent" android:layout_height="match_parent"/>

                    </FrameLayout>

                </LinearLayout>

            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>
</FrameLayout>