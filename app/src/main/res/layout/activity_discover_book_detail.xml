<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:tag="theme:bg"
    android:background="#080808">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:overScrollMode="never"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="48dp" android:paddingBottom="8dp">

                <ImageButton
                    android:id="@+id/detailBtnBack"
                    android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_back" android:tint="#DDDDDD"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"/>
            </LinearLayout>

            <!-- HERO ROW: cover + title/author/badges beside it, like a
                 store listing header -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:paddingTop="8dp">

                <FrameLayout
                    android:layout_width="120dp" android:layout_height="170dp"
                    android:background="@drawable/bg_recent_card">

                    <ImageView
                        android:id="@+id/detailCover"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginStart="16dp" android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/detailFeaturedBadge"
                        android:tag="theme:card"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="★ Featured" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="#FFC400" android:background="@drawable/bg_button_dark"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:visibility="gone" android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/detailTitle"
                        android:tag="theme:textPrimary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:maxLines="4" android:ellipsize="end" android:lineSpacingMultiplier="1.15"/>

                    <TextView
                        android:id="@+id/detailAuthor"
                        android:tag="theme:textSecondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="#8A8A8A"
                        android:maxLines="2" android:ellipsize="end"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/detailCategoryLanguage"
                        android:tag="theme:accent"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="11sp" android:textColor="#4488FF"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- STAT ROW: rating / downloads / pages / size, like a
                 store listing's stat strip -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="20dp"
                android:tag="theme:card"
                android:background="@drawable/bg_continue_card"
                android:padding="14dp">

                <LinearLayout style="@style/DetailStatCell">
                    <TextView android:id="@+id/detailStatRating" style="@style/DetailStatValue" android:text="—"/>
                    <TextView style="@style/DetailStatLabel" android:text="Rating"/>
                </LinearLayout>

                <View style="@style/DetailStatDivider"/>

                <LinearLayout style="@style/DetailStatCell">
                    <TextView android:id="@+id/detailStatDownloads" style="@style/DetailStatValue" android:text="—"/>
                    <TextView style="@style/DetailStatLabel" android:text="Downloads"/>
                </LinearLayout>

                <View style="@style/DetailStatDivider"/>

                <LinearLayout style="@style/DetailStatCell">
                    <TextView android:id="@+id/detailStatPages" style="@style/DetailStatValue" android:text="—"/>
                    <TextView style="@style/DetailStatLabel" android:text="Pages"/>
                </LinearLayout>

                <View style="@style/DetailStatDivider"/>

                <LinearLayout style="@style/DetailStatCell">
                    <TextView android:id="@+id/detailStatSize" style="@style/DetailStatValue" android:text="—"/>
                    <TextView style="@style/DetailStatLabel" android:text="Size"/>
                </LinearLayout>

            </LinearLayout>

            <!-- DESCRIPTION -->
            <TextView
                android:tag="theme:textSecondary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ABOUT THIS BOOK" android:textSize="10sp" android:letterSpacing="0.16"
                android:textColor="#707070"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:layout_marginTop="24dp" android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/detailDescription"
                android:tag="theme:textPrimary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="#DDDDDD" android:lineSpacingMultiplier="1.5"
                android:paddingStart="24dp" android:paddingEnd="24dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- STICKY BOTTOM ACTION BAR — same three-state pattern as the grid
         card, just full width -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:tag="theme:card"
        android:background="@drawable/bg_bar_bottom"
        android:padding="16dp">

        <TextView
            android:id="@+id/detailBtnDownload"
            android:tag="theme:buttonBg,theme:buttonText"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:gravity="center" android:text="Download"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#000000"
            android:background="@drawable/bg_open_button"
            android:clickable="true" android:focusable="true"/>

        <LinearLayout
            android:id="@+id/detailProgressGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">

            <ProgressBar
                android:id="@+id/detailProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp"
                android:max="100" android:progress="0"/>

            <TextView
                android:id="@+id/detailProgressText"
                android:tag="theme:textSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center"
                android:textSize="12sp" android:textColor="#707070"
                android:text="Downloading… 0%"/>
        </LinearLayout>

        <TextView
            android:id="@+id/detailBtnOpen"
            android:tag="theme:outline"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:gravity="center" android:text="Open"
            android:textSize="15sp" android:textStyle="bold"
            android:background="@drawable/bg_outline_button"
            android:clickable="true" android:focusable="true"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>